<Window x:Class="Yandex2Spotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Яндекс Музыка → Spotify" Width="1080" Height="790" MinWidth="850" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F5F1" Foreground="#1A2822"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#4F6258" />
        <SolidColorBrush x:Key="Line" Color="#DBE3DC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Background" Value="#EDF2ED" />
            <Setter Property="Foreground" Value="#192D23" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#4B7962" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#196947" />
            <Setter Property="BorderBrush" Value="#196947" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#AABAAF" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#AABAAF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="#EDF2ED" />
            <Setter Property="Foreground" Value="#36493E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TrackCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="9,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Яндекс Музыка → Spotify" FontSize="30" FontWeight="Bold" Margin="0,0,0,14" />

        <Grid x:Name="Connections" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="True">
                        <TextBlock Text="Яндекс Музыка" Style="{StaticResource CardTitle}" Margin="0,0,12,0" />
                        <TextBlock x:Name="YandexAccount" Text="Нет подключения" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                    </DockPanel>
                    <Button Content="Войти через Яндекс" Click="SignInYandex_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <Label Content="OAuth-токен (ручной ввод)" Target="{Binding ElementName=YandexToken}" Style="{StaticResource FieldLabel}" />
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Подключить" Click="ConnectYandex_Click" Margin="8,0,0,0" />
                        <PasswordBox x:Name="YandexToken" />
                    </DockPanel>
                    <Label Content="Плейлист-источник" Target="{Binding ElementName=YandexSource}" Style="{StaticResource FieldLabel}" />
                    <DockPanel LastChildFill="True">
                        <Button x:Name="LoadYandexButton" DockPanel.Dock="Right" Content="Загрузить треки" Click="LoadYandex_Click" Margin="8,0,0,0" />
                        <ComboBox x:Name="YandexSource" DisplayMemberPath="Name" IsEnabled="False" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,9" LastChildFill="True">
                        <TextBlock Text="Spotify" Style="{StaticResource CardTitle}" Margin="0,0,12,0" />
                        <TextBlock x:Name="SpotifyAccount" Text="Нет подключения" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                    </DockPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Client ID" Target="{Binding ElementName=SpotifyId}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SpotifyId" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label Content="Redirect URI" Target="{Binding ElementName=RedirectUri}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RedirectUri" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Подключить" Click="ConnectSpotify_Click" Margin="0,0,7,0" />
                        <Button x:Name="SwitchSpotifyButton" Content="Сменить аккаунт" Click="SwitchSpotify_Click" Margin="0,0,7,0" Visibility="Collapsed" />
                        <Button Content="Как подключить?" Click="SpotifyHelp_Click" />
                    </WrapPanel>
                    <Label Content="Куда добавить" Target="{Binding ElementName=Destination}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="Destination" DisplayMemberPath="Name" SelectionChanged="Destination_SelectionChanged" IsEnabled="False" />
                    <StackPanel x:Name="NewPlaylistFields" Visibility="Collapsed" Margin="0,7,0,0">
                        <Label Content="Название нового плейлиста" Target="{Binding ElementName=NewPlaylistName}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NewPlaylistName" MaxLength="100" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <TabControl x:Name="TrackTabs" BorderThickness="0" Background="White">
                <TabItem Header="Список треков" Padding="10,5">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="TrackActions" Margin="0,0,0,7" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Открыть JSON…" Click="OpenFile_Click" Margin="0,0,6,0" />
                                <Button x:Name="SaveTracksButton" Content="Сохранить выбранные…" Click="SaveTracks_Click" />
                            </StackPanel>
                            <TextBlock x:Name="TrackSource" Text="Треки не загружены" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="2,0,8,0" FontWeight="SemiBold" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,7" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="SelectAllButton" Content="Выбрать все" Click="SelectAll_Click" Margin="0,0,6,0" />
                                <Button x:Name="ClearSelectionButton" Content="Снять выбор" Click="ClearSelection_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SelectionCount" Margin="2,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="TrackGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="29"
                                  HorizontalGridLinesBrush="#E8EDE8" AlternatingRowBackground="#F7F9F7" Background="White" BorderBrush="{StaticResource Line}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="✓" ToolTip="Включить в перенос" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" AutomationProperties.Name="Перенести трек" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource TrackCell}" />
                                <DataGridTextColumn Header="Исполнители" Binding="{Binding Artists}" Width="1.5*" IsReadOnly="True" ElementStyle="{StaticResource TrackCell}" />
                                <DataGridTextColumn Header="Альбом" Binding="{Binding Albums}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource TrackCell}" />
                                <DataGridTextColumn Header="Время" Binding="{Binding Duration}" Width="76" IsReadOnly="True" ElementStyle="{StaticResource TrackCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="MissingTab" Header="Не найдено" Padding="10,5">
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="SaveMissingButton" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,7"
                                Content="Сохранить список…" Click="SaveMissing_Click" />
                        <ListBox x:Name="MissingList" DisplayMemberPath="Label" BorderBrush="{StaticResource Line}" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="StatusText" Text="Подключите Яндекс Музыку или откройте сохранённый JSON." TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="Progress" Height="5" Margin="0,7,0,0" Foreground="#196947" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,7,0" />
                <Button x:Name="ImportButton" Content="Перенести в Spotify" Click="Import_Click" Style="{StaticResource Primary}" MinHeight="39" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
