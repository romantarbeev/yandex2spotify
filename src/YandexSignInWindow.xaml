<Window x:Class="Yandex2Spotify.YandexSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Яндекс Музыку" Width="465" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#F3F5F1"
        Foreground="#1A2822" FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="22">
        <TextBlock Text="Вход в Яндекс Музыку" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="Откройте страницу Яндекса, введите код и подтвердите доступ к своему аккаунту."
                   TextWrapping="Wrap" Margin="0,8,0,14" />
        <Border Background="White" BorderBrush="#DBE3DC" BorderThickness="1" CornerRadius="6" Padding="12,5">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Копировать код" Click="CopyCode_Click" Padding="10,5" Margin="5,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"
                           AutomationProperties.Name="Код подтверждения" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="Feedback" Text="После подтверждения приложение подключится автоматически." TextWrapping="Wrap"
                   Foreground="#4F6258" Margin="0,12,0,14" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отменить" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Открыть страницу Яндекса" Click="OpenPage_Click" IsDefault="True" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
